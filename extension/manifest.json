{
  "manifest_version": 3,
  "name": "BrandLedger Guard - Pre-Publish Claim Verifier",
  "version": "1.0.0",
  "description": "Pre-publish claim verification for brand governance. Verifies numbers, terms, and claims in AI output and drafts against the Brand Source of Truth.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrandLedger Guard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
